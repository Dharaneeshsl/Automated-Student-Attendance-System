# ---------------------------------------------------------------------------
# AttendEase — environment template
#
# Copy this file to `.env` and fill in your values. `.env` is git-ignored.
# These are only needed when deploying to Cloudflare remotely — local
# development works out of the box with Miniflare.
# ---------------------------------------------------------------------------

# Cloudflare account identifier (find it on the Workers dashboard overview page)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token with "Workers Scripts: Edit" + "D1: Edit" permissions
CLOUDFLARE_API_TOKEN=

# Optional: override the D1 database id (defaults to the one in wrangler.jsonc)
# D1_DATABASE_ID=01985c5e-bd1d-71b6-8fb3-00492bfae37b

# Optional: Cloudflare observability / logging
# CLOUDFLARE_LOGS=true
